{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/team/instagram-profile",
      "destination": "/api/team/instagram-profile"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
