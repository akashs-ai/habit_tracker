# ==============================================================================
# LifeRPG Environment Variables Template
# Copy this file to .env or .env.local and populate the values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# Required for multi-agent AI coaching (Gemini, Claude, ChatGPT persona routing)
# Get your API key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase Backend Configuration (Server-Side)
# Used by Express backend for authoritative database operations & JWT verification
# Project Settings -> API in your Supabase dashboard (https://supabase.com/dashboard)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Supabase Client Configuration (Vite / Browser Frontend)
# Exposes Supabase URL & Public Anon Key to client-side authentication & realtime
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. SerpApi Configuration (Server-Side Only - NEVER expose to browser/client)
# Used by Express backend for Team Expo Instagram profile picture synchronization
# Get your API key from: https://serpapi.com/dashboard
# ------------------------------------------------------------------------------
SERPAPI_API_KEY=
